import serial
import time

# [중요] 본인의 아두이노 포트로 수정하세요 (예: 'COM3')
try:
    py_serial = serial.Serial(port='COM3', baudrate=9600, timeout=1)
    time.sleep(2)
    print("아두이노와 연결되었습니다.")
except:
    print("아두이노 연결 실패: 포트 번호를 확인하세요.")

print("--- 키보드 LED 제어 프로그램 ---")
print("1~5 숫자를 입력하고 Enter를 누르세요. (종료는 'q')")

while True:
    cmd = input("LED 번호 입력 (1~5): ")
    
    if cmd == 'q':
        break
    
    if cmd in ['1', '2', '3', '4', '5']:
        py_serial.write(cmd.encode())
        print(f"{cmd}번 LED를 켰습니다.")
    else:
        print("잘못된 입력입니다. 1~5 사이의 숫자를 입력하세요.")

py_serial.close()
