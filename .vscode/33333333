import cv2
import mediapipe as mp
import serial
import time

# 1. 아두이노와 연결된 COM 포트 설정 (본인 포트에 맞게 수정하세요)
try:
    py_serial = serial.Serial(port='COM4', baudrate=9600, timeout=1)
    print("아두이노 연결 성공!")
except Exception as e:
    print("아두이노 연결 실패. 포트를 확인하세요:", e)
    py_serial = None

# MediaPipe 손 인식 초기화
mp_hands = mp.solutions.hands
hands = mp_hands.Hands(max_num_hands=1, min_detection_confidence=0.7)
mp_draw = mp.solutions.drawing_utils

# 2. 카메라 연결 (카메라 모듈 장치)
cap = cv2.VideoCapture(0) # 일반 웹캠 인식 인덱스 (안 뜨면 1이나 2로 변경)

prev_signal = ""

while cap.isOpened():
    success, img = cap.read()
    if not success:
        continue

    img = cv2.flip(img, 1) # 좌우 반전
    img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    results = hands.process(img_rgb)

    if results.multi_hand_landmarks:
        for hand_landmarks in results.multi_hand_landmarks:
            mp_draw.draw_landmarks(img, hand_landmarks, mp_hands.HAND_CONNECTIONS)
            
            # 손가락이 펴졌는지 체크하는 간단한 알고리즘 (끝마디 좌표 비교)
            # 엄지, 검지, 중지, 약지, 새끼 순서
            tips = [4, 8, 12, 16, 20]
            fingers = []
            
            # 엄지 손가락 (좌우 방향 기준 체크)
            if hand_landmarks.landmark[tips[0]].x < hand_landmarks.landmark[tips[0] - 1].x:
                fingers.append(1)
            else:
                fingers.append(0)
                
            # 나머지 네 손가락 (위아래 y좌표 기준 체크)
            for i in range(1, 5):
                if hand_landmarks.landmark[tips[i]].y < hand_landmarks.landmark[tips[i] - 2].y:
                    fingers.append(1)
                else:
                    fingers.append(0)
            
            # 편 손가락의 총 개수 계산
            total_fingers = fingers.count(1)
            cv2.putText(img, f'Fingers: {total_fingers}', (20, 80), cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 255, 0), 2)
            
            # 3. 손가락 개수에 따라 아두이노로 다른 신호 전송 (값의 변화가 있을 때만 한 번 전송)
            current_signal = str(total_fingers)
            if current_signal != prev_signal and py_serial:
                py_serial.write(current_signal.encode()) # 아두이노로 '0', '1', '2' 등을 보냄
                print(f"아두이노로 신호 전송: {current_signal}")
                prev_signal = current_signal

    cv2.imshow("Hand Tracking Control", img)
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
if py_serial: py_serial.close()
