void loop() {
  // 1. 컴퓨터(파이썬)로부터 들어온 데이터가 있는지 확인
  if (Serial.available() > 0) {
    
    // 2. 들어온 데이터 한 글자를 읽어서 cmd 변수에 저장
    char cmd = Serial.read();

    // 3. 새로운 명령을 처리하기 전에 일단 모든 LED를 끕니다.
    digitalWrite(ledBlue, LOW);
    digitalWrite(ledYellow, LOW);
    digitalWrite(ledRed, LOW);
    digitalWrite(ledGreen, LOW);
    digitalWrite(ledWhite, LOW);

    // 4. 수신된 cmd 문자에 따라 해당하는 LED만 켭니다.
    if (cmd == '1') {
      digitalWrite(ledBlue, HIGH);    // '1'이 들어오면 파란색 ON
    } 
    else if (cmd == '2') {
      digitalWrite(ledYellow, HIGH);  // '2'가 들어오면 노란색 ON
    } 
    else if (cmd == '3') {
      digitalWrite(ledRed, HIGH);     // '3'이 들어오면 빨간색 ON
    } 
    else if (cmd == '4') {
      digitalWrite(ledGreen, HIGH);   // '4'가 들어오면 초록색 ON
    } 
    else if (cmd == '5') {
      digitalWrite(ledWhite, HIGH);   // '5'가 들어오면 흰색 ON
    }
  }
}
