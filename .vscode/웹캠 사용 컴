import cv2
import mediapipe as mp
import serial

# 아두이노 연결 (환경에 맞게 COM 포트 변경)
arduino = serial.Serial('COM3', 9600)

mp_hands = mp.solutions.hands
mp_drawing = mp.solutions.drawing_utils

cap = cv2.VideoCapture(0)

def classify_gesture(hand_landmarks):
    wrist = hand_landmarks.landmark[mp_hands.HandLandmark.WRIST]
    tips = {
        "thumb": hand_landmarks.landmark[mp_hands.HandLandmark.THUMB_TIP],
        "index": hand_landmarks.landmark[mp_hands.HandLandmark.INDEX_FINGER_TIP],
        "middle": hand_landmarks.landmark[mp_hands.HandLandmark.MIDDLE_FINGER_TIP],
        "ring": hand_landmarks.landmark[mp_hands.HandLandmark.RING_FINGER_TIP],
        "pinky": hand_landmarks.landmark[mp_hands.HandLandmark.PINKY_TIP],
    }
    fingers = {name: (tip.y < wrist.y) for name, tip in tips.items()}

    if all(not f for f in fingers.values()):
        return 1   # ✊ 주먹
    elif all(f for f in fingers.values()):
        return 2   # ✋ 손바닥
    elif fingers["index"] and fingers["middle"] and not fingers["ring"] and not fingers["pinky"]:
        return 3   # ✌️ V자
    elif fingers["thumb"] and not any([fingers["index"], fingers["middle"], fingers["ring"], fingers["pinky"]]):
        return 4   # 👍 엄지
    elif fingers["thumb"] and fingers["index"] and fingers["pinky"] and not fingers["middle"] and not fingers["ring"]:
        return 5   # 🤟 I Love You
    else:
        return 0   # 알 수 없음

with mp_hands.Hands(max_num_hands=1) as hands:
    while True:
        ret, frame = cap.read()
        if not ret:
            break

        image = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        results = hands.process(image)
        image = cv2.cvtColor(image, cv2.COLOR_RGB2BGR)

        if results.multi_hand_landmarks:
            for hand_landmarks in results.multi_hand_landmarks:
                mp_drawing.draw_landmarks(image, hand_landmarks, mp_hands.HAND_CONNECTIONS)
                gesture_code = classify_gesture(hand_landmarks)
                if gesture_code != 0:
                    arduino.write(str(gesture_code).encode())  # 아두이노로 전송

        cv2.imshow("Hand Gesture Recognition", image)
        if cv2.waitKey(5) & 0xFF == 27:  # ESC 종료
            break

cap.release()
cv2.destroyAllWindows()