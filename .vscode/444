import cv2
import mediapipe as mp
import serial
import time

# --------------------------------------------------------
# [설정 영역] 본인의 환경에 맞게 COM 포트 번호를 수정하세요!
# --------------------------------------------------------
ARDUINO_PORT = 'COM3'  # 아두이노 포트 번호 (장치 관리자에서 확인한 포트)
BAUDRATE = 9600        # 아두이노와 맞춘 통신 속도

# 1. 아두이노 시리얼 통신 초기화
try:
    py_serial = serial.Serial(port=ARDUINO_PORT, baudrate=BAUDRATE, timeout=1)
    time.sleep(2) # 아두이노 연결 후 안정화를 위한 2초 대기
    print(f"[{ARDUINO_PORT}] 아두이노와 연결 성공!")
except Exception as e:
    print(f"⚠️ 아두이노 연결 실패! 포트 번호나 시리얼 모니터가 켜져 있는지 확인하세요.\n오류 내용: {e}")
    py_serial = None

# 2. 구글 MediaPipe Hands 라이브러리 초기화
mp_hands = mp.solutions.hands
hands = mp_hands.Hands(
    max_num_hands=1,                # 한 번에 한 손만 인식하도록 제한 (연산 속도 최적화)
    min_detection_confidence=0.7,   # 손 검출 최소 신뢰도
    min_tracking_confidence=0.7     # 추적 최소 신뢰도
)
mp_draw = mp.solutions.drawing_utils # 화면에 관절을 그려주는 도구

# 3. 카메라 연결 (0번으로 안 뜨면 외장 카메라인 1 또는 2로 변경해 보세요)
CAMERA_INDEX = 0
cap = cv2.VideoCapture(CAMERA_INDEX)

if not cap.isOpened():
    print(f"⚠️ {CAMERA_INDEX}번 카메라를 열 수 없습니다. 인덱스를 1 또는 2로 변경해 보세요.")
    exit()

print("인공지능 카메라 시스템 구동 시작... 종료하려면 창을 클릭하고 'q'를 누르세요.")
prev_signal = "" # 이전 전송 신호 저장용 변수 (중복 전송 방지)

# 4. 실시간 메인 루프 시작
while cap.isOpened():
    success, img = cap.read()
    if not success:
        print("카메라 프레임을 읽어오지 못했습니다.")
        continue

    # 연산 속도 향상 및 좌우 반전(거울 모드) 처리
    img = cv2.flip(img, 1)
    img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB) # MediaPipe는 RGB 이미지를 사용합니다.
    results = hands.process(img_rgb)

    total_fingers = 0

    # 화면에 손이 포착된 경우
    if results.multi_hand_landmarks:
        for hand_landmarks in results.multi_hand_landmarks:
            # 화면에 손가락 21개 뼈대 관절 그리기
            mp_draw.draw_landmarks(img, hand_landmarks, mp_hands.HAND_CONNECTIONS)
            
            # 손가락 끝마디 관절 번호 (엄지, 검지, 중지, 약지, 새끼 순)
            tips = [4, 8, 12, 16, 20]
            fingers = []
            
            # [엄지 손가락 판별 법칙] 마디 좌표의 X축 비교
            if hand_landmarks.landmark[tips[0]].x < hand_landmarks.landmark[tips[0] - 1].x:
                fingers.append(1) # 펴짐
            else:
                fingers.append(0) # 접힘
                
            # [네 손가락 판별 법칙] 손가락 끝(tip)이 아래 마절 관절보다 위에(Y값이 작게) 있는지 비교
            for i in range(1, 5):
                if hand_landmarks.landmark[tips[i]].y < hand_landmarks.landmark[tips[i] - 2].y:
                    fingers.append(1) # 펴짐
                else:
                    fingers.append(0) # 접힘
            
            # 편 손가락의 총 합산 계산
            total_fingers = fingers.count(1)

            # 5. 아두이노로 데이터 송신 (데이터 전송 최적화: 값이 바뀔 때 딱 1번만 전송)
            current_signal = str(total_fingers)
            if current_signal != prev_signal:
                if py_serial and py_serial.is_open:
                    py_serial.write(current_signal.encode()) # 문자를 바이트(Byte) 스트림으로 인코딩하여 전송
                    print(f"📡 아두이노 송신 완료 -> 손가락 개수: {current_signal}")
                prev_signal = current_signal

    # 화면에 인식 결과 텍스트 표시
    cv2.putText(img, f'Fingers: {total_fingers}', (20, 70), 
                cv2.FONT_HERSHEY_SIMPLEX, 1.5, (0, 255, 0), 3)
    
    # 윈도우 영상 출력 창 생성
    cv2.imshow("Hand Tracking Control", img)

    # 창이 맨 앞에 뜨지 않을 경우를 대비해 항상 최상단에 고정하는 명령
    cv2.setWindowProperty("Hand Tracking Control", cv2.WND_PROP_TOPMOST, 1)

    # 'q' 키를 누르면 루프 탈출 및 안전 종료
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

# 6. 사용한 자원 해제 및 종료 처리
cap.release()
cv2.destroyAllWindows()
if py_serial and py_serial.is_open:
    py_serial.close()
print("시스템이 안전하게 종료되었습니다.")
